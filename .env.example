# ==========================================================
# QUICKFIXHUB - ENVIRONMENT VARIABLES (.env.example)
# ==========================================================

# 1. URL Pública del Sitio (en Vercel será https://quickfixhub.vercel.app o tu dominio propio)
NEXT_PUBLIC_SITE_URL=https://quickfixhub.vercel.app

# 2. MONETAG - Monetización desde el Día 1 (Configurar en Vercel -> Environment Variables)
# Meta etiqueta de verificación de sitio de Monetag (solo el código content="..." si te lo piden)
NEXT_PUBLIC_MONETAG_VERIFICATION=

# MultiTag (Recomendado: activa todos los formatos optimizados con 1 solo ID de zona)
NEXT_PUBLIC_MONETAG_MULTITAG_ZONE_ID=
NEXT_PUBLIC_MONETAG_MULTITAG_SRC=https://alwingulla.com/88/tag.min.js

# Formatos individuales opcionales (si prefieres configurarlos por separado en lugar de MultiTag)
NEXT_PUBLIC_MONETAG_INPAGE_PUSH_ZONE_ID=
NEXT_PUBLIC_MONETAG_NATIVE_BANNER_ZONE_ID=
NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE_ID=

# Mostrar recuadros guía de espacios publicitarios (true para previsualizar dónde van los anuncios, false en producción)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# 3. GOOGLE SEARCH CONSOLE (Opcional: código de verificación para SEO)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 4. AUTOMATIZACIÓN CON GEMINI API (Configurar en GitHub -> Settings -> Secrets -> Actions)
# Nombre del secreto en GitHub: GEMINI_API_KEY
GEMINI_API_KEY=
